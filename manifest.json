{
  "manifest_version": 3,
  "name": "CanvasFlow",
  "version": "1.0.0",
  "description": "Converts an image into guided canvas strokes.",
  "permissions": ["storage"],
  "action": {
    "default_title": "CanvasFlow"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
